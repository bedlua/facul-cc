algoritmo "Exercício 09"
var

inicio
      escreva ("qual o valor do salário mínimo?")
      leia (v)
      escreva ("quantas horas foram trabalhadas?")
      leia (h)
      escreva ("qual o número de dependentes?")
      leia (d)
      escreva ("qual a quantidade de horas extras trabalhadas?")
      leia (he)
fimalgoritmo